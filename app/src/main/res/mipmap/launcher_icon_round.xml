<!-- Round launcher icon fallback for launchers below Android 8.0, which render layer lists as
     plain drawables. It draws the same rounded-square card and artwork as the adaptive icon's
     foreground, on a transparent background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="31dp"
        android:left="31dp"
        android:right="31dp"
        android:top="31dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary_light" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:bottom="31dp"
        android:drawable="@mipmap/launcher_icon_foreground"
        android:left="31dp"
        android:right="31dp"
        android:top="31dp" />
</layer-list>
